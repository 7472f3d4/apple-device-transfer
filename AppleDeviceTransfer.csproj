<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ApplicationIcon>Assets\backup-icon-6970243.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>AppleDeviceTransfer</AssemblyName>
    <RootNamespace>AppleDeviceTransfer</RootNamespace>
    <Version>1.0.8</Version>
    <AssemblyVersion>1.0.8.0</AssemblyVersion>
    <FileVersion>1.0.8.0</FileVersion>
    <Product>iPhone / iPad データ転送</Product>
    <Description>Windows-only USB file transfer for iPhone and iPad</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\backup-icon-6970243-512.png" />
    <Content Include="README.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="THIRD-PARTY-NOTICES.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="THIRD-PARTY-LICENSES\**\*" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildAppleDeviceBridge" BeforeTargets="Build">
    <Exec WorkingDirectory="$(MSBuildThisFileDirectory)bridge" Command="cargo build --release" />
  </Target>

  <Target Name="CopyAppleDeviceBridgeToBuild" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)bridge\target\release\apple-device-bridge.exe"
          DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyAppleDeviceBridgeToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)bridge\target\release\apple-device-bridge.exe"
          DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
