<Window x:Class="AppleDeviceTransfer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iPhone / iPad データ転送"
        Icon="/AppleDeviceTransfer;component/Assets/backup-icon-6970243-512.png"
        Width="1024" Height="720" MinWidth="880" MinHeight="620"
        FontFamily="Segoe UI Variable Text, Meiryo UI, Segoe UI" FontSize="13"
        Foreground="#17253A" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#17253A" />
        <SolidColorBrush x:Key="Muted" Color="#626B78" />
        <SolidColorBrush x:Key="Line" Color="#D7DCE2" />
        <SolidColorBrush x:Key="Accent" Color="#3F607A" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#D7DCE2" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F2F3F5" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#BFC5CD" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Border" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="White" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#E2E5E9" />
                                <Setter Property="Foreground" Value="#858C96" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="Foreground" Value="#31445D" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="RowHeight" Value="30" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA" />
            <Setter Property="ColumnHeaderHeight" Value="34" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCE9FF" />
                    <Setter Property="Foreground" Value="#123F91" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="#D7DCE2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SelectionBrush" Value="#C5D9FC" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="White" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EAF1FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#DCE9FF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="#D7DCE2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder" Background="White" BorderBrush="#D7DCE2"
                                BorderThickness="1" CornerRadius="2">
                                            <Path Data="M 0 0 L 5 5 L 10 0" Stroke="#31445D" StrokeThickness="1.5"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#AEB4BC" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#AEB4BC" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="12,0,38,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Border Background="White" BorderBrush="#D7DCE2" BorderThickness="1" CornerRadius="2"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,4,0,0">
                                    <ScrollViewer MaxHeight="320" CanContentScroll="True" Margin="4">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TabControl Grid.Row="0" x:Name="MainTabs" Background="Transparent" BorderThickness="0">
            <TabItem Header="ファイル転送">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Background="Transparent" BorderThickness="0"
                            CornerRadius="0" Padding="4,4" Margin="0,0,6,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="端末" VerticalAlignment="Center" Margin="0,0,12,0"
                                       FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                            <ComboBox x:Name="DeviceComboBox" Grid.Column="1" Height="34" FontSize="13"
                                      ToolTip="USB端末は自動検出されます。端末のロックを解除し、表示されたら「このコンピュータを信頼」を選択してください。"
                                      DisplayMemberPath="Name" SelectionChanged="DeviceComboBox_SelectionChanged" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Background="Transparent" BorderThickness="0"
                            CornerRadius="0" Padding="4,4" Margin="6,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="転送先アプリ" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource Ink}" />
                            </StackPanel>
                            <ComboBox x:Name="AppComboBox" Grid.Column="1" Height="34" FontSize="13"
                                      ToolTip="ファイル共有に対応しているアプリが転送先になります。"
                                      DisplayMemberPath="Name" SelectionChanged="AppComboBox_SelectionChanged" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="Transparent" BorderThickness="0"
                                CornerRadius="0" Padding="8,4,10,4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="このPC" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                <Grid Grid.Row="1" Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="LocalPathTextBox" Height="32" Padding="8,4"
                                             VerticalContentAlignment="Center" FontSize="13"
                                             LostFocus="LocalPathTextBox_LostFocus" />
                                    <Button x:Name="BrowseLocalButton" Grid.Column="1" Content="…"
                                            Style="{StaticResource IconButton}" Margin="7,0,0,0"
                                            ToolTip="フォルダーを選択" Click="BrowseLocalButton_Click" />
                                    <Button x:Name="LocalUpButton" Grid.Column="2" Content="↑"
                                            Style="{StaticResource IconButton}" Margin="7,0,0,0"
                                            ToolTip="上のフォルダー" Click="LocalUpButton_Click" />
                                </Grid>
                                <DataGrid x:Name="LocalGrid" Grid.Row="2" AutoGenerateColumns="False"
                                          CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#EEF2F7" RowHeaderWidth="0"
                                          SelectionUnit="FullRow" SelectionMode="Extended" Background="Transparent"
                                          BorderThickness="0" FontSize="13" MouseDoubleClick="LocalGrid_MouseDoubleClick"
                                          SelectionChanged="LocalGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="名前" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Image Source="{Binding Icon}" Width="16" Height="16"
                                                               Stretch="Uniform" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="サイズ" Binding="{Binding SizeText}" Width="85" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Width="1" Background="{StaticResource Line}"
                                HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0,12,0,12" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Button x:Name="UploadButton" Content="→" Width="40" Height="36" FontSize="21"
                                    AutomationProperties.Name="PCから接続端末へ転送"
                                    ToolTip="PCの一覧で選択した項目を、接続端末の共有書類へ転送します。"
                                    Style="{StaticResource IconButton}" Margin="0,0,0,8"
                                    Click="UploadButton_Click" IsEnabled="False" />
                            <Button x:Name="DownloadButton" Content="←" Width="40" Height="36" FontSize="21"
                                    AutomationProperties.Name="接続端末からPCへ転送"
                                    ToolTip="接続端末の共有書類で選択した項目を、左のPCフォルダーへ保存します。"
                                    Style="{StaticResource IconButton}"
                                    Click="DownloadButton_Click" IsEnabled="False" />
                        </StackPanel>

                        <Border Grid.Column="1" Width="1" Background="{StaticResource Line}"
                                HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,12,0,12" />

                        <Border Grid.Column="2" Background="Transparent" BorderThickness="0"
                                CornerRadius="0" Padding="10,4,8,4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="RemoteTitleText" Text="端末の共有書類" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Ink}" />
                                        <TextBlock x:Name="RemotePathText" Text="/" Margin="0,4,0,0"
                                                   FontSize="13" Foreground="{StaticResource Muted}" />
                                    </StackPanel>
                                    <Button x:Name="RemoteUpButton" Grid.Column="1" Content="↑"
                                            Style="{StaticResource IconButton}" Margin="6,0,6,0"
                                            ToolTip="上のフォルダー" Click="RemoteUpButton_Click" />
                                    <Button x:Name="RefreshRemoteButton" Grid.Column="2" Content="↻"
                                            Style="{StaticResource IconButton}" ToolTip="一覧を更新"
                                            Click="RefreshRemoteButton_Click" />
                                </Grid>
                                <Grid Grid.Row="1">
                                <DataGrid x:Name="RemoteGrid" AutoGenerateColumns="False"
                                          CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#EEF2F7" RowHeaderWidth="0"
                                          SelectionUnit="FullRow" SelectionMode="Extended" Background="Transparent"
                                          BorderThickness="0" FontSize="13" MouseDoubleClick="RemoteGrid_MouseDoubleClick"
                                          SelectionChanged="RemoteGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="名前" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Image Source="{Binding Icon}" Width="16" Height="16"
                                                               Stretch="Uniform" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="サイズ" Binding="{Binding SizeText}" Width="85" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16"
                                                IsHitTestVisible="False">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems, ElementName=RemoteGrid}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock x:Name="RemoteEmptyText" Text="端末を検索中…"
                                                   FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                                                   TextAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="写真・動画の取り込み">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="Transparent" BorderThickness="0"
                            CornerRadius="0" Padding="4,4" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="保存先" VerticalAlignment="Center" Margin="0,0,12,0"
                                       FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                            <TextBox x:Name="PhotoDestinationTextBox" Grid.Column="1" Height="32" Padding="8,4"
                                     VerticalContentAlignment="Center" FontSize="13" />
                            <Button Grid.Column="2" Content="…" Style="{StaticResource IconButton}"
                                    ToolTip="保存先フォルダーを選択" Margin="7,0,7,0"
                                    Click="BrowsePhotoButton_Click" />
                            <Button x:Name="ScanPhotosButton" Grid.Column="3" Content="端末を検索"
                                    Click="ScanPhotosButton_Click" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Background="Transparent" BorderThickness="0"
                            CornerRadius="0" Padding="8,4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="端末の写真と動画" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource Ink}" />
                                <TextBlock x:Name="PhotoCountText" Text="未検索" Margin="12,2,0,0"
                                           FontSize="13" Foreground="{StaticResource Muted}" />
                            </StackPanel>
                            <DataGrid x:Name="MediaGrid" Grid.Row="1" AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#EEF2F7" RowHeaderWidth="0"
                                      SelectionUnit="FullRow" SelectionMode="Extended" Background="Transparent"
                                      BorderThickness="0" FontSize="13">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="選択" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="60" />
                                    <DataGridTextColumn Header="ファイル名" Binding="{Binding Name}" Width="2*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="端末内フォルダー" Binding="{Binding Folder}" Width="2*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="種類" Binding="{Binding Kind}" Width="85" IsReadOnly="True" />
                                    <DataGridTextColumn Header="サイズ" Binding="{Binding SizeText}" Width="100" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ImportPhotosButton" Grid.Column="1" Content="選択項目を取り込む"
                                Style="{StaticResource PrimaryButton}" IsEnabled="False"
                                ToolTip="写真・動画をPCへコピーします。元データは端末に残ります。"
                                Click="ImportPhotosButton_Click" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Margin="0,8,0,0" Background="Transparent" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" CornerRadius="0" Padding="0,6,0,0">
        <StackPanel>
            <TextBlock x:Name="StatusText" Text="USB端末を検索中…"
                       TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Ink}" />
            <ProgressBar x:Name="OperationProgress" Height="5" Margin="0,7,0,0"
                         Minimum="0" Maximum="100" Visibility="Collapsed" />
            <TextBlock Margin="0,4,0,0" HorizontalAlignment="Right" FontSize="12"
                       Foreground="{StaticResource Muted}">
                <Run Text="アイコン：backup icon by muhamad afiffudin from Noun Project (CC BY 3.0) — thenounproject.com" />
            </TextBlock>
        </StackPanel>
        </Border>
    </Grid>
</Window>
